# Copy to .env for local compose overrides. Do not commit a real .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/ecommerce
TEST_DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/ecommerce_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600
ADMIN_EMAILS=admin@example.com
